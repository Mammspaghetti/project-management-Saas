# Copy to .env and adapt. Never commit the real file.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=change-me-db

# >= 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
JWT_TTL_MINUTES=60

# Optional: creates the first ADMIN account at startup
ADMIN_EMAIL=admin@taskflow.local
ADMIN_PASSWORD=change-me-admin

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
